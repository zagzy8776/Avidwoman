# ------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------------

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for admin writes / seed scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — Dashboard -> Product Environment (the ONLY media store)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset used by the admin upload widget
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Payments — NONE. Checkout is a manual bank transfer: the client enters
# her bank name / account number / account name in Admin -> Settings and
# the order waits as "pending payment" until she marks it paid.
# No provider key is needed for this phase.
#
# If a gateway is agreed later, the question to ask first is still:
# does she settle in Naira (Paystack / Flutterwave — Stripe does not pay
# out to Nigeria) or a foreign currency (Stripe)? Only then add keys here.
# ------------------------------------------------------------------
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
